import os
import time
import requests
import skrypt  # Importujemy funkcję z głównego skryptu raportującego

TOKEN = os.environ.get("TELEGRAM_TOKEN")
CHAT_ID = os.environ.get("TELEGRAM_CHAT_ID")

def wyslij_wiadomosc(chat_id, tekst):
    url = f"https://api.telegram.org/bot{TOKEN}/sendMessage"
    payload = {"chat_id": chat_id, "text": tekst, "parse_mode": "HTML"}
    try:
        requests.post(url, json=payload)
    except Exception as e:
        print(f"Błąd wysyłania wiadomości: {e}")

def obsluz_komendy():
    """Pobiera nieprzeczytane wiadomości z Telegrama i na nie odpowiada."""
    url = f"https://api.telegram.org/bot{TOKEN}/getUpdates"
    try:
        res = requests.get(url).json()
        if res.get("ok") and res.get("result"):
            for update in res["result"]:
                msg = update.get("message", {})
                tekst = msg.get("text", "").strip()
                chat_id = msg.get("chat", {}).get("id")
                update_id = update.get("update_id")

                if not tekst or not chat_id:
                    continue

                # Reakcja na komendę /start
                if tekst == "/start":
                    wyslij_wiadomosc(chat_id, "OK")
                    print("Obsłużono komendę /start -> wysłano 'OK'")

                # Reakcja na komendę /raport
                elif tekst == "/raport":
                    wyslij_wiadomosc(chat_id, "⏳ Generuję raport walorów...")
                    skrypt.main()  # Uruchomienie wysyłki raportu
                    print("Obsłużono komendę /raport -> wygenerowano raport")

                # Potwierdzenie przetworzenia wiadomości w Telegramie (offset)
                requests.get(f"{url}?offset={update_id + 1}")

    except Exception as e:
        print(f"Błąd podczas pobierania wiadomości: {e}")

if __name__ == "__main__":
    print("Uruchamianie menu.py...")
    obsluz_komendy()
